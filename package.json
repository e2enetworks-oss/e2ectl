{
  "name": "@e2enetworks-oss/e2ectl",
  "version": "0.6.1",
  "description": "Command-line interface for managing E2E Networks resources from the terminal.",
  "homepage": "https://github.com/e2enetworks-oss/e2ectl#readme",
  "bugs": {
    "url": "https://github.com/e2enetworks-oss/e2ectl/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e2enetworks-oss/e2ectl.git"
  },
  "type": "module",
  "bin": {
    "e2ectl": "dist/app/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node ./scripts/clean.mjs dist .tmp && tsc -p tsconfig.build.json",
    "clean": "node ./scripts/clean.mjs",
    "coverage": "npm run coverage:unit && npm run coverage:integration",
    "coverage:integration": "npm run build && c8 --all --src src --exclude-after-remap --exclude \"tests/**\" --exclude \"dist/**\" --exclude \"scripts/**\" --exclude \"src/**/*-types.ts\" --exclude \"src/**/types.ts\" --exclude \"src/**/types/**\" --reporter text --reporter html --reporter lcov --report-dir coverage/integration node ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "coverage:unit": "vitest run --coverage",
    "dev": "node --import tsx ./src/app/index.ts",
    "docs:check": "node ./scripts/docs-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --type-aware --deny-warnings src tests scripts vitest.config.ts vitest.integration.config.ts vitest.manual.config.ts vitest.manual-destructive.config.ts vitest.manual-smoke.config.ts",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:manual": "vitest run --config vitest.manual.config.ts",
    "test:manual:dbaas": "vitest run --config vitest.manual-destructive.config.ts tests/manual/destructive/dbaas/",
    "test:manual:lb": "vitest run --config vitest.manual-destructive.config.ts tests/manual/destructive/load-balancer/",
    "test:manual:smoke": "vitest run --config vitest.manual-smoke.config.ts",
    "test:manual:smoke:cleanup": "node ./scripts/manual-smoke-cleanup.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "cli",
    "e2e",
    "cloud",
    "myaccount"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "c8": "12.0.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "node-html-parser": "^7.1.0"
  }
}
